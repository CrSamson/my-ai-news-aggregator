{
  "expo": {
    "name": "Brevio",
    "slug": "brevio",
    "version": "0.1.0",
    "description": "One story, every source, full timeline. A daily news digest for AI, technology, business, and science.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brevio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF5EE",
      "dark": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#1A1410"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.brevio.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAF5EE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "ai.brevio.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Brevio",
      "shortName": "Brevio",
      "description": "One story, every source, full timeline.",
      "themeColor": "#EE9970",
      "backgroundColor": "#FAF5EE",
      "display": "standalone",
      "lang": "en"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
