# Brevio mobile — environment variables
#
# Copy to `.env` and tweak for local dev. Variables prefixed with
# EXPO_PUBLIC_ are inlined into the JS bundle at build time and
# available as `process.env.EXPO_PUBLIC_*` in the running app.

# API base URL. Falls back to the production Modal URL if unset, so
# `npm start` works out of the box without any .env config.
EXPO_PUBLIC_API_URL=https://crsamson--brevio-api-fastapi-app.modal.run

# When developing the API locally, point at uvicorn instead:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8765
